{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickFox",
  "version": "1.3.0",
  "identifier": "com.zhangzzds.quickfox",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "QuickFox",
        "label": "main",
        "width": 760,
        "height": 420,
        "minWidth": 520,
        "minHeight": 320,
        "center": true,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "transparent": true,
        "shadow": false
      },
      {
        "title": "QuickFox 设置",
        "label": "settings",
        "url": "/?view=settings",
        "width": 920,
        "height": 640,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "visible": false,
        "decorations": true,
        "resizable": true,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
